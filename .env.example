NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://user:password@localhost:5432/reel_scheduler
DATABASE_SSL=false
APP_BASE_URL=http://localhost:8000
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
TOKEN_ENCRYPTION_KEY=replace-with-40-plus-random-characters

# Shown on the public Privacy/Terms/Contact pages. Meta checks it, so use a real inbox you read.
SUPPORT_EMAIL=you@yourdomain.com
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
# Optional safety limits (defaults shown)
IG_DAILY_POST_CAP=5
MAX_ACCOUNTS_PER_USER=5
